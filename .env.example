# Resend API key (https://resend.com/api-keys) — sends the lead notification email
RESEND_API_KEY=
# Where lead notifications are delivered
CONTACT_TO=osama.iftikhar.alburhan@gmail.com

# Supabase (Dashboard → Project Settings → API) — stores every lead in the `leads` table
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key: server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
